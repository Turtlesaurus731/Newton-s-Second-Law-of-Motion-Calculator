<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <StackPane alignment="CENTER_RIGHT" nodeOrientation="RIGHT_TO_LEFT" style="-fx-background-color: #ffffff;">
         <children>
            <Canvas fx:id="output" height="500.0" nodeOrientation="RIGHT_TO_LEFT" style="-fx-background-color: #ffffff;" width="500.0" />
         </children>
      </StackPane>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Force Vectors" />
            <ListView fx:id="forceVectorListView" />
         </children>
      </VBox>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" spacing="10.0">
         <children>
            <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="18.0" text="Add Force Vector" />
            <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="26.0" spacing="10.0">
               <children>
                  <TextField prefHeight="26.0" prefWidth="90.0" promptText="X" fx:id="xForceVectorTextField" />
                  <TextField fx:id="yForceVectorTextField" prefHeight="26.0" prefWidth="90.0" promptText="Y" />
                  <Label prefHeight="18.0" text="N" />
               </children>
            </HBox>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#onActionAddButton" prefHeight="25.0" prefWidth="130.0" text="Add" />
            <Button fx:id="removeButton" mnemonicParsing="false" onAction="#onActionRemoveButton" prefHeight="25.0" prefWidth="130.0" text="Remove" />
            <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onActionResetButton" prefHeight="25.0" prefWidth="130.0" text="Reset" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Mass: " />
                  <TextField fx:id="massTextField">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </TextField>
               </children>
               <VBox.margin>
                  <Insets top="50.0" />
               </VBox.margin>
            </HBox>
            <CheckBox fx:id="netAccelerationCheckBox" mnemonicParsing="false" onAction="#onActionNetAccelerationCheckBox" text="Show Net Acceleration" />
            <CheckBox fx:id="darkModeToggleCheckBox" mnemonicParsing="false" onAction="#onActionDarkModeToggleCheckBox" text="Dark Mode Toggle" />
         </children>
      </VBox>
      <VBox alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>
            <Button fx:id="infoButton" alignment="CENTER" maxHeight="29.0" maxWidth="29.0" mnemonicParsing="false" onAction="#onActionInfoButton" prefHeight="29.0" prefWidth="29.0" style="-fx-background-radius: 999; -fx-background-color: lightblue; -fx-font-weight: bold; -fx-font-style: italic;" text="i" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>
