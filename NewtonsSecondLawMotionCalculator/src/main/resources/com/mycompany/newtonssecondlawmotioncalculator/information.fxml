                  <Image url="@../../../InformationImage01.png" />
               </image>
            </ImageView>
         </children>
      </VBox>
      <ScrollPane fitToWidth="true" prefHeight="700.0" prefWidth="463.0">
         <content>
            <VBox prefHeight="698.0" prefWidth="417.0" spacing="6.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
